PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=clinic_management_data
DB_TEST_NAME=clinic_management_test
DB_PRODUCTION_NAME=clinic_management
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_TIME=7d

# Required for clinic cover images, patient profile photos, and private medical documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Calendar reminders use the same SMTP provider as account email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediPulse OS <no-reply@medipulse.local>
APP_DEFAULT_TIMEZONE=Asia/Kolkata
CALENDAR_REMINDER_POLL_INTERVAL_MS=60000
CALENDAR_REMINDER_MAX_ATTEMPTS=5
